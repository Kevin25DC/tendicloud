---
import '../styles/global.css';
import { FAQS, PLANS, SEO, SITE } from '../config';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: boolean;
}
const { title, description, noindex = false, jsonLd = false } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og-image.png', site).href;

const ld = jsonLd && {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.href}#org`,
      name: SITE.name,
      url: site.href,
      logo: new URL('/icon-512.png', site).href,
      email: SITE.email,
      areaServed: 'CO',
    },
    {
      '@type': 'WebSite',
      '@id': `${site.href}#web`,
      name: SITE.name,
      url: site.href,
      inLanguage: 'es-CO',
      publisher: { '@id': `${site.href}#org` },
    },
    {
      '@type': 'SoftwareApplication',
      name: SITE.name,
      description: SEO.description,
      url: site.href,
      image: ogImage,
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: 'Punto de venta (POS)',
      operatingSystem: 'Web, Windows, macOS, Android, iOS',
      inLanguage: 'es-CO',
      publisher: { '@id': `${site.href}#org` },
      offers: PLANS.filter((p) => p.monthly).map((p) => ({
        '@type': 'Offer',
        name: `Plan ${p.name}`,
        price: p.monthly,
        priceCurrency: 'COP',
        description: p.blurb,
        url: `${site.href}#precios`,
      })),
      featureList: [
        'Punto de venta con lector de código de barras',
        'Facturación electrónica DIAN',
        'Caja con arqueo por turno y medio de pago',
        'Inventario',
        'Cartera y fiado',
        'Compras y proveedores',
        'Reportes de ventas',
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQS.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
const ldJson = ld ? JSON.stringify(ld).replace(/</g, '\\u003c') : '';
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SEO.keywords.join(', ')} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {SEO.googleVerification && <meta name="google-site-verification" content={SEO.googleVerification} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SEO.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TendiCloud, el POS en la nube para tiendas de barrio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#050a14" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {ldJson && <script type="application/ld+json" set:html={ldJson} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Montserrat:wght@600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
    <script>
      import Lenis from 'lenis';

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let lenis: Lenis | null = null;
      if (!reduce) {
        lenis = new Lenis({ lerp: 0.1 });
        const raf = (t: number) => {
          lenis!.raf(t);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const id = a.getAttribute('href')!;
          if (id.length < 2) return;
          const target = document.querySelector<HTMLElement>(id);
          if (!target) return;
          e.preventDefault();
          if (lenis) lenis.scrollTo(target, { offset: -72 });
          else target.scrollIntoView();
        });
      });

      function splitWords(el: HTMLElement) {
        let i = 0;
        const walk = (node: Node) => {
          [...node.childNodes].forEach((child) => {
            if (child.nodeType === Node.TEXT_NODE) {
              const frag = document.createDocumentFragment();
              child.textContent!.split(/(\s+)/).forEach((part) => {
                if (!part) return;
                if (/^\s+$/.test(part)) {
                  frag.append(part);
                  return;
                }
                const w = document.createElement('span');
                w.className = 'w';
                const inner = document.createElement('span');
                inner.textContent = part;
                inner.style.setProperty('--i', String(i++));
                w.append(inner);
                frag.append(w);
              });
              child.replaceWith(frag);
            } else if (child.nodeType === Node.ELEMENT_NODE && (child as Element).tagName !== 'BR') {
              walk(child);
            }
          });
        };
        walk(el);
      }
      document.querySelectorAll<HTMLElement>('[data-split]').forEach(splitWords);

      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal],[data-split],[data-draw]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
