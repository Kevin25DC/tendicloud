---
import { SITE, contactHref } from '../config';
const arrow = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8h10M9 4l4 4-4 4"/></svg>';
---
<section class="cta">
  <div class="wrap">
    <div class="cta-box" data-draw>
      <svg class="cta-chart" viewBox="0 0 1200 420" preserveAspectRatio="none" aria-hidden="true">
        <path pathLength="1" d="M0 380 L140 350 L250 366 L370 290 L480 318 L610 236 L720 262 L850 160 L960 184 L1090 70 L1200 40" />
      </svg>
      <img class="cta-mark" src="/logo-mark.webp" alt="" width="113" height="72" loading="lazy" decoding="async" />
      <h2 class="display" data-split>Abre caja con TendiCloud <span class="hl">hoy mismo.</span></h2>
      <p data-reveal style="--d:.3s">Crea tu cuenta, carga tus productos y haz tu primera venta en la misma tarde. Si te atrancas, te ayudamos.</p>
      <div class="cta-actions" data-reveal style="--d:.45s">
        <a class="btn btn-primary btn-lg" href={SITE.signupUrl}>Probar {SITE.trialDays} días gratis <Fragment set:html={arrow} /></a>
        <a class="btn btn-line btn-lg" href={contactHref}>{SITE.whatsapp ? 'Escribir por WhatsApp' : 'Hablar con ventas'}</a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .cta { padding: 0 0 clamp(96px, 12vw, 150px); }
  .cta-box {
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 9vw, 120px) clamp(24px, 6vw, 80px);
    border: 1px solid var(--line-2);
    border-radius: 28px;
    text-align: center;
    background:
      radial-gradient(60% 80% at 50% 0%, rgba(47, 128, 224, .28), transparent 70%),
      linear-gradient(180deg, #0b1830, #070f1d);
  }
  .cta-box::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(140, 175, 225, .06) 1px, transparent 1px), linear-gradient(90deg, rgba(140, 175, 225, .06) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(70% 70% at 50% 40%, #000, transparent);
    mask-image: radial-gradient(70% 70% at 50% 40%, #000, transparent);
  }
  .cta-chart { position: absolute; inset: auto 0 0; width: 100%; height: 70%; }
  .cta-chart path { fill: none; stroke: var(--sky); stroke-width: 1.5; opacity: .35; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .cta-box.in .cta-chart path { stroke-dashoffset: 0; transition: stroke-dashoffset 2.6s cubic-bezier(.6, .1, .2, 1) .2s; }
  .cta-mark { position: relative; width: auto; height: 64px; margin: 0 auto 28px; filter: drop-shadow(0 10px 30px rgba(79, 184, 245, .45)); animation: cta-float 5s ease-in-out infinite; }
  @keyframes cta-float { 50% { transform: translateY(-8px); } }
  .cta-box h2 { position: relative; max-width: 14ch; margin: 0 auto; font-size: clamp(38px, 6vw, 84px); letter-spacing: -.045em; }
  .cta-box p { position: relative; max-width: 52ch; margin: 24px auto 0; color: var(--ink-2); font-size: clamp(16px, 1.4vw, 19px); }
  .cta-actions { position: relative; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 36px; }
  @media (max-width: 520px) {
    .cta-box { border-radius: 22px; }
    .cta-mark { height: 52px; margin-bottom: 22px; }
    .cta-actions { flex-direction: column; }
    .cta-actions .btn { width: 100%; }
  }
</style>
