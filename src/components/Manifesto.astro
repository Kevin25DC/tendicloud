<section class="mani" data-mani>
  <div class="mani-sticky">
    <div class="wrap">
      <span class="eyebrow">Por qué existe</span>
      <p class="mani-text" data-mani-text>
        Un tendero no debería cerrar el día contando billetes sobre el mostrador y sumando el cuaderno del fiado.
        Debería saber cuánto vendió, cuánto le deben y qué se le está acabando.
        <span class="hl">Para eso hicimos TendiCloud.</span>
      </p>
      <div class="mani-bar"><i></i></div>
    </div>
  </div>
</section>

<style is:global>
  .mani { position: relative; height: 240vh; }
  .mani-sticky { position: sticky; top: 0; display: flex; align-items: center; height: 100vh; }
  .mani-text {
    max-width: 1120px;
    margin-top: 30px;
    font: 700 clamp(28px, 4.2vw, 60px)/1.12 var(--f-display);
    letter-spacing: -.03em;
  }
  .js .mani-text .mw { opacity: .14; transition: opacity .35s; }
  .js .mani-text .mw.on { opacity: 1; }
  .mani-bar { position: relative; height: 1px; margin-top: 48px; max-width: 1120px; background: var(--line); }
  .mani-bar i { position: absolute; inset: 0 auto 0 0; width: calc(var(--mp, 0) * 100%); background: var(--sky); }
  .mani.static { height: auto; }
  .mani.static .mani-sticky { position: static; height: auto; padding: 140px 0; }
  .mani.static .mani-bar { display: none; }
</style>

<script>
  const sec = document.querySelector<HTMLElement>('[data-mani]');
  const text = sec?.querySelector<HTMLElement>('[data-mani-text]');
  if (sec && text) {
    const words: HTMLElement[] = [];
    const walk = (node: Node) => {
      [...node.childNodes].forEach((child) => {
        if (child.nodeType === Node.TEXT_NODE) {
          const frag = document.createDocumentFragment();
          child.textContent!.split(/(\s+)/).forEach((part) => {
            if (!part) return;
            if (/^\s+$/.test(part)) {
              frag.append(' ');
              return;
            }
            const s = document.createElement('span');
            s.className = 'mw';
            s.textContent = part;
            words.push(s);
            frag.append(s);
          });
          child.replaceWith(frag);
        } else if (child.nodeType === Node.ELEMENT_NODE) walk(child);
      });
    };
    walk(text);

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      sec.classList.add('static');
      words.forEach((w) => w.classList.add('on'));
    } else {
      const update = () => {
        const r = sec.getBoundingClientRect();
        const p = Math.min(Math.max(-r.top / (r.height - innerHeight), 0), 1);
        const lit = Math.round(Math.min(p * 1.15, 1) * words.length);
        words.forEach((w, i) => w.classList.toggle('on', i < lit));
        sec.style.setProperty('--mp', p.toFixed(3));
      };
      addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
      update();
    }
  }
</script>
